<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EggCoop</AssemblyName>
    <Version>0.1.0</Version>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)..\..\lab\p1</GameDir>
    <Managed>$(GameDir)\Egging On_Data\Managed</Managed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="1.3.1" />
    <PackageReference Include="Mono.Nat" Version="3.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(Managed)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(Managed)\Rewired_Core.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.UnityWebRequestModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="$(Managed)\netstandard.dll" Private="false" />
  </ItemGroup>

  <!-- Copy plugin + its libs into every lab copy: dotnet build -p:Deploy=true -->
  <Target Name="Deploy" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <ItemGroup>
      <PluginFiles Include="$(OutDir)EggCoop.dll;$(OutDir)LiteNetLib.dll;$(OutDir)Mono.Nat.dll" />
      <LabDirs Include="$(MSBuildThisFileDirectory)..\..\lab\p1;$(MSBuildThisFileDirectory)..\..\lab\p2" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="%(LabDirs.FullPath)\BepInEx\plugins\EggCoop" />
  </Target>

</Project>
